# ====================================================================
# id_x_010 前端环境变量声明（Next.js 构建期注入）
#
# 使用方法：
#   cp .env.local.example .env.local
#   # 按需修改 .env.local 后执行 cnpm run build / cnpm run dev
#
# Next.js 在 next build / next dev 时自动加载 .env.local，
# 以 NEXT_PUBLIC_ 前缀的变量会被内联进客户端 bundle。
# 详见 src/utils/config.ts。
# ====================================================================

# API 基础地址：浏览器端用相对路径（留空），由 haproxy 同源转发到后端 service
NEXT_PUBLIC_BASE_URL=

# GraphQL 端点子路径（与后端路由前缀 /b/id_x_010/graphql 对齐）
NEXT_PUBLIC_SUB_VERSION=/b/id_x_010/graphql

# ===== SSO 单点登录（ADFS OAuth2 授权码授予流，前端仅公开信息） =====
# 业务站点 https 域名（resource 参数，默认即可）
NEXT_PUBLIC_SITE_URL=https://your-public-host
# 大学统一身份认证系统分配的 Client ID（公开标识，client_secret 仅服务端持有）
NEXT_PUBLIC_ADFS_CLIENT_ID=373d4823-7c0b-4375-a16c-e902f979ee34
# 回调地址：必须与 ADFS 注册地址、后端 AA_OAUTH_REDIRECT_URI 完全一致
# （https，区分大小写）
NEXT_PUBLIC_ADFS_REDIRECT_URI=https://your-public-host/f/010/oauth2
# 可选：ADFS OAuth2 端点，不填则使用默认 CUHK ADFS
# NEXT_PUBLIC_ADFS_BASE_URL=https://sts.cuhk.edu.cn/adfs/oauth2
