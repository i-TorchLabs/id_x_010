# ====================================================================
# id_x_010 容器部署环境变量（外部第三方 PostgreSQL 模式，对齐 id_x_007）
#
# 首次运行 up.sh 时会从本文件生成 .env，请按需修改后重新运行。
#
# 数据库：不再内置 db 容器 / pgvector 镜像，service 直连下列外部库；
# 库须预先建好（CREATE DATABASE），表结构与预置数据由应用启动时
# 幂等创建/播种（create_all + x_seed / _seed_model_prices），
# ops/init/*.sql 仅作手动初始化/审阅参考。
#
# 本文件同时承担两个角色：
#   1. up.sh 读取（外部库连接参数、镜像与端口选择、容器内连通性预检）
#   2. 以 --env-file 注入 service 容器，并挂载为引擎层根 .env
#      （加载优先级：模块 .env > 根 .env > base_config.toml）
# ====================================================================

# ---- 外部第三方 PostgreSQL（必填） ----
# 库跑在容器宿主机本机时可填 host.containers.internal（podman 4+，
# Pod 内各容器共享网络命名空间，service 须经该别名回访宿主机端口；
# 127.0.0.1 在容器内指向容器自身，不可用）或宿主机内网 IP；
# 数据库侧 pg_hba.conf 须放行容器出站地址。
DB_HOST=
DB_PORT=5432
DB_NAME=id_x_010
DB_USERNAME=postgres
DB_PASSWORD=

# ---- 初始管理员账号（应用启动播种，幂等；取代原 ops/init/09_admin.sql） ----
# 目标邮箱不存在时由应用播种（bcrypt 哈希落库）；留空则默认
# sme@cuhk.edu.cn / P@sssme!（与原 09_admin.sql 预置一致）
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- 镜像与端口 ----
HAPROXY_IMAGE=docker.io/library/haproxy:3.0
# 宿主机暴露端口（haproxy 入口）：http://localhost:<POD_PORT>/
POD_PORT=8010

# ---- 模型配置（service 容器）----
# external（云端 OpenAI 兼容 API）| local（Ollama）
# 决定运行时从 external_provider 表还是 local_provider 表读取提供商配置
LLM_PROVIDER=external
# 提供商 api_key 与各类 base_url 由应用启动时幂等播种至 external_provider /
# local_provider 表（x_seed，预置内容同 init/02~03），运维可直接改表维护。

# ---- SQL Agent 目标库（与业务库物理隔离，可选）----
# 连接配置存业务库 agent_db_settings 表（应用启动幂等播种，预置内容同
# init/04_agent.sql）；表无数据则 SQL 智能体不可用，其余功能不受影响。

# ---- 运行时开关（可选）----
# DEBUG_MODE=false
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# ---- SSO 单点登录（ADFS OAuth2 授权码授予流）----
# SSO 配置（client_id / client_secret / redirect_uri）由应用启动幂等播种至
# sso_settings 表（x_seed，预置内容同 init/07_oauth.sql），取 id 最小行
# 作为生效配置；运维可直接改表维护。

# ---- 前端构建期注入（NEXT_PUBLIC_* 在 npm run build 时内联进客户端 bundle）----
# 与后端 sso_settings.redirect_uri 必须完全一致（ADFS 注册地址）
NEXT_PUBLIC_SITE_URL=https://your-public-host
NEXT_PUBLIC_ADFS_CLIENT_ID=373d4823-7c0b-4375-a16c-e902f979ee34
NEXT_PUBLIC_ADFS_REDIRECT_URI=https://your-public-host/f/010/oauth2
# resource 参数：默认取 NEXT_PUBLIC_SITE_URL
NEXT_PUBLIC_ADFS_RESOURCE=https://your-public-host
# 可选：ADFS OAuth2 端点，不填则使用默认 CUHK ADFS
NEXT_PUBLIC_ADFS_BASE_URL=https://sts.cuhk.edu.cn/adfs/oauth2

# ---- 可观测性（TASK-007）----
# Prometheus 抓取端口（compose.yaml 中 prometheus 服务发布到宿主机）
PROM_PORT=9090
# LangSmith / OpenTelemetry trace 上报；保持 false 时不影响主流程
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=id_x_010
# OTLP HTTP 端点，如 http://otel-collector:4318；为空则不上报
OTEL_EXPORTER_OTLP_ENDPOINT=
