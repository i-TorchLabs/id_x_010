# ====================================================================
# id_x_010 一体化容器部署环境变量
#
# 首次运行 up.sh 时会从本文件生成 .env，请按需修改后重新运行。
#
# 本文件同时承担两个角色：
#   1. up.sh 读取（db 容器初始化参数、镜像与端口选择）
#   2. 以 --env-file 注入 service 容器，并挂载为引擎层根 .env
#      （加载优先级：模块 .env > 根 .env > base_config.toml）
# ====================================================================

# ---- PostgreSQL（db 容器）----
POSTGRES_DB=id_x_010
POSTGRES_USER=postgres
POSTGRES_PASSWORD=P@sspostgres!

# ---- 镜像与端口 ----
# TASK-001: 改用 pgvector 镜像以支持 table_comments / document_chunks 向量列
POSTGRES_IMAGE=docker.io/pgvector/pgvector:pg18
HAPROXY_IMAGE=docker.io/library/haproxy:3.0
# 宿主机暴露端口（haproxy 入口）：http://localhost:<POD_PORT>/
POD_PORT=8010
# 宿主机暴露端口（PostgreSQL 直连）：psql -h localhost -p <DB_HOST_PORT> -U postgres -d id_x_010
DB_HOST_PORT=54321

# ---- 模型配置（service 容器）----
# external（云端 OpenAI 兼容 API）| local（Ollama）
# 决定运行时从 external_provider 表还是 local_provider 表读取提供商配置
LLM_PROVIDER=external
# 提供商 api_key 与各类 base_url 已迁移至数据库表 external_provider /
# local_provider（建表见 init/01_init.sql 第 9、10 节，各取 id 最小行
# 作为生效配置），运行时优先读表；以下环境变量仅作表无数据时的回退：
EXTERNAL_API_KEY=
EXTERNAL_LLM_BASE_URL=https://api.siliconflow.cn/v1
EXTERNAL_EMBD_BASE_URL=https://api.siliconflow.cn/v1
EXTERNAL_VL_BASE_URL=https://api.siliconflow.cn/v1
LLM_PROVIDER=local 时改为指向宿主机 Ollama：
LOCAL_LLM_BASE_URL=http://host.containers.internal:11434/v1
LOCAL_EMBD_BASE_URL=http://host.containers.internal:11434/v1
LOCAL_VL_BASE_URL=http://host.containers.internal:11434/v1

# ---- SQL Agent 目标库（与业务库物理隔离，可选）----
# 连接配置已迁移至业务库 agent_db_settings 表（每行一个可选数据库，
# 建表见 init/01_init.sql 第 8 节），运行时优先读表。
# 以下环境变量仅在表无数据时作为回退（支持明文直填或 _ENC 加密值，
# 用主程序 utils/encrypt_util.py 生成）。不配且表为空则 SQL 智能体
# 不可用，其余功能不受影响。
AGENT_DB_HOST=127.0.0.1
AGENT_DB_PORT=5432
AGENT_DB_NAME=analytics
AGENT_DB_USERNAME=readonly
AGENT_DB_PASSWORD=secret
# 可选库清单回退（表为空时 getDatabases 接口返回）。支持两种格式：
#   1. JSON 映射 {"显示名":"真实库名"} —— 前端选择器渲染显示名，后端按真实库名建连
#   2. 逗号分隔纯名称列表 —— 显示名与真实库名相同
AGENT_DB_LIST={"S&P数据库":"ex_biaopu_target","FactSet数据库":"ex_factset","RatingExpress数据库":"ex_rating_express"}

# ---- 运行时开关（可选）----
# DEBUG_MODE=false
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# ---- SSO 单点登录（ADFS OAuth2 授权码授予流）----
# 大学统一身份认证系统（ADFS）分配的 Client ID / 共享秘钥。
# client_secret 仅服务端持有，绝不进入前端代码；AA_OAUTH_REDIRECT_URI
# 必须与 ADFS 注册地址、前端 NEXT_PUBLIC_ADFS_REDIRECT_URI 完全一致
# （https，区分大小写）。容器内部以 --env-file 注入 service 容器。
AA_OAUTH_CLIENT_ID=373d4823-7c0b-4375-a16c-e902f979ee34
AA_OAUTH_CLIENT_SECRET=xKczBbxvKZ2kELoUiuEfkLPkmYF2yN2V0jAHpgD0
# 宿主机入口默认 http://localhost:8010（由 POD_PORT 控制），ADFS 注册
# 必须用 https 公网域名；本地开发可用 ngrok / 内网穿透获得 https 入口。
AA_OAUTH_REDIRECT_URI=https://your-public-host/f/010/oauth2

# ---- 前端构建期注入（NEXT_PUBLIC_* 在 npm run build 时内联进客户端 bundle）----
# 与后端 AA_OAUTH_REDIRECT_URI 必须完全一致（ADFS 注册地址）
NEXT_PUBLIC_SITE_URL=https://your-public-host
NEXT_PUBLIC_ADFS_CLIENT_ID=373d4823-7c0b-4375-a16c-e902f979ee34
NEXT_PUBLIC_ADFS_REDIRECT_URI=https://your-public-host/f/010/oauth2
# resource 参数：默认取 NEXT_PUBLIC_SITE_URL
NEXT_PUBLIC_ADFS_RESOURCE=https://your-public-host
# 可选：ADFS OAuth2 端点，不填则使用默认 CUHK ADFS
NEXT_PUBLIC_ADFS_BASE_URL=https://sts.cuhk.edu.cn/adfs/oauth2

# ---- 可观测性（TASK-007）----
# Prometheus 抓取端口（compose.yaml 中 prometheus 服务发布到宿主机）
PROM_PORT=9090
# LangSmith / OpenTelemetry trace 上报；保持 false 时不影响主流程
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=id_x_010
# OTLP HTTP 端点，如 http://otel-collector:4318；为空则不上报
OTEL_EXPORTER_OTLP_ENDPOINT=
