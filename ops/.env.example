# ====================================================================
# id_x_010 一体化容器部署环境变量
#
# 首次运行 up.sh 时会从本文件生成 .env，请按需修改后重新运行。
#
# 本文件同时承担两个角色：
#   1. up.sh 读取（db 容器初始化参数、镜像与端口选择）
#   2. 以 --env-file 注入 service 容器，并挂载为引擎层根 .env
#      （加载优先级：模块 .env > 根 .env > base_config.toml）
# ====================================================================

# ---- PostgreSQL（db 容器）----
POSTGRES_DB=id_x_010
POSTGRES_USER=postgres
POSTGRES_PASSWORD=P@sspostgres!

# ---- 镜像与端口 ----
POSTGRES_IMAGE=docker.io/library/postgres:18
HAPROXY_IMAGE=docker.io/library/haproxy:3.0
# 宿主机暴露端口（haproxy 入口）：http://localhost:<POD_PORT>/
POD_PORT=8010
# 宿主机暴露端口（PostgreSQL 直连）：psql -h localhost -p <DB_HOST_PORT> -U postgres -d id_x_010
DB_HOST_PORT=54321

# ---- 模型配置（service 容器）----
# external（云端 OpenAI 兼容 API）| local（Ollama）
# 决定运行时从 external_provider 表还是 local_provider 表读取提供商配置
LLM_PROVIDER=external
# 提供商 api_key 与各类 base_url 已迁移至数据库表 external_provider /
# local_provider（建表见 init/01_init.sql 第 9、10 节，各取 id 最小行
# 作为生效配置），运行时优先读表；以下环境变量仅作表无数据时的回退：
# EXTERNAL_API_KEY=
# EXTERNAL_LLM_BASE_URL=https://api.siliconflow.cn/v1
# EXTERNAL_EMBD_BASE_URL=https://api.siliconflow.cn/v1
# EXTERNAL_VL_BASE_URL=https://api.siliconflow.cn/v1
# LLM_PROVIDER=local 时改为指向宿主机 Ollama：
# LOCAL_LLM_BASE_URL=http://host.containers.internal:11434/v1
# LOCAL_EMBD_BASE_URL=http://host.containers.internal:11434/v1
# LOCAL_VL_BASE_URL=http://host.containers.internal:11434/v1

# ---- SQL Agent 目标库（与业务库物理隔离，可选）----
# 连接配置已迁移至业务库 agent_db_settings 表（每行一个可选数据库，
# 建表见 init/01_init.sql 第 8 节），运行时优先读表。
# 以下环境变量仅在表无数据时作为回退（支持明文直填或 _ENC 加密值，
# 用主程序 utils/encrypt_util.py 生成）。不配且表为空则 SQL 智能体
# 不可用，其余功能不受影响。
# AGENT_DB_HOST=127.0.0.1
# AGENT_DB_PORT=5432
# AGENT_DB_NAME=analytics
# AGENT_DB_USERNAME=readonly
# AGENT_DB_PASSWORD=secret
# 可选库清单回退（表为空时 getDatabases 接口返回，JSON 数组或逗号分隔）
# AGENT_DB_LIST=primary,analytics

# ---- 运行时开关（可选）----
# DEBUG_MODE=false
# RATE_LIMIT_MAX_REQUESTS=120
# RATE_LIMIT_WINDOW_SECONDS=60
