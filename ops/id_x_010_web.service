# id-x-010_web.service: systemd 服务端启动配置
# sudo systemctl daemon-reload
# sudo systemctl start id-x-010_web.service
# sudo systemctl status id-x-010_web.service
[Unit]
Description=ID X 010 Web Application
After=network.target

[Service]
Type=simple
User=master
Group=master
WorkingDirectory=/home/master/Desktop/codeSpace/id_x_000/x_models/id-x-010/web
ExecStart=/usr/bin/cnpm run start
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
