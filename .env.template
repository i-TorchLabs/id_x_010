# ====================================================================
# 环境变量加载优先级（高 → 低）：
#   1. 模块 .env  (x_models/id_x_010/.env)  — 本文件，覆盖根 .env 同名变量
#   2. 项目根 .env (i-Core/.env)
#
# 说明：高优先级的环境变量会覆盖低优先级的同名环境变量。
# ====================================================================

# --------------------------------------------------------------------
# 数据库配置
# --------------------------------------------------------------------

# 本模块映射的数据库名（明文），主程序按模块独立建连
DB_NAME=id_x_010

# 数据库连接参数（加密存储，用主程序 utils/encrypt_util.py 生成，运行时自动解密）
DB_HOST=encrypted_db_host
DB_PORT=encrypted_db_port
DB_USERNAME=encrypted_db_username
DB_PASSWORD=encrypted_db_password

# --------------------------------------------------------------------
# 模型配置
# --------------------------------------------------------------------

# LLM 模型提供商（可选值: external | local）
# 决定运行时从 external_provider 表还是 local_provider 表读取
# 提供商配置（api_key 与各类 base_url），本项保留在配置文件中
LLM_PROVIDER=external

# 外部云端 / 本地 Ollama 提供商配置已迁移至数据库表
# external_provider / local_provider（建表见 ops/init/01_init.sql 第 9、10 节，
# 各取 id 最小行作为生效配置）。表无数据时仍回退以下环境变量（可选）：
EXTERNAL_API_KEY=sk-xxx
EXTERNAL_LLM_BASE_URL=https://api.siliconflow.cn/v1   # 或 EXTERNAL_BASE_URL
EXTERNAL_EMBD_BASE_URL=https://api.siliconflow.cn/v1
EXTERNAL_VL_BASE_URL=https://api.siliconflow.cn/v1
LOCAL_API_KEY=ollama                                  # 或 LOCAL_MODEL_API_KEY
LOCAL_LLM_BASE_URL=http://localhost:11434/v1          # 或 LOCAL_MODEL_BASE_URL
LOCAL_EMBD_BASE_URL=http://localhost:11434/v1
LOCAL_VL_BASE_URL=http://localhost:11434/v1

# --------------------------------------------------------------------
# SQL Agent 配置
# --------------------------------------------------------------------

# SQL Agent 目标库连接配置已迁移至数据库表 agent_db_settings
# （建表见 ops/init/01_init.sql 第 8 节，每行一个可选数据库）。
# 运行时优先读表；表无数据时仍回退以下环境变量（可选，_ENC 为加密值，
# 用主程序 utils/encrypt_util.py 生成）：
AGENT_DB_NAME=xxx            # 或 AGENT_DB_NAME_ENC=encrypted_db_name
AGENT_DB_HOST=127.0.0.1      # 或 AGENT_DB_HOST_ENC=encrypted_db_host
AGENT_DB_PORT=5432           # 或 AGENT_DB_PORT_ENC=encrypted_db_port
AGENT_DB_USERNAME=readonly   # 或 AGENT_DB_USERNAME_ENC=encrypted_db_username
AGENT_DB_PASSWORD=secret     # 或 AGENT_DB_PASSWORD_ENC=encrypted_db_password
AGENT_DB_LIST={"S&P数据库":"ex_biaopu_target"}  # 可选库清单（表为空时 getDatabases 的回退来源）；JSON 映射 {"显示名":"真实库名"}，前端渲染显示名、后端按真实库名建连；
# 也兼容逗号分隔纯名称列表（显示名=库名）

# --------------------------------------------------------------------
# SSO 单点登录（ADFS OAuth2 授权码授予流）
# --------------------------------------------------------------------
# 大学统一身份认证系统（ADFS）分配的 Client ID / 共享秘钥。
# client_secret 仅服务端持有，绝不进入前端代码 / 环境变量；
# AA_OAUTH_REDIRECT_URI 必须与 ADFS 注册地址、前端 NEXT_PUBLIC_ADFS_REDIRECT_URI
# 完全一致（https，区分大小写）。
AA_OAUTH_CLIENT_ID=373d4823-7c0b-4375-a16c-e902f979ee34
AA_OAUTH_CLIENT_SECRET=xKczBbxvKZ2kELoUiuEfkLPkmYF2yN2V0jAHpgD0
AA_OAUTH_REDIRECT_URI=https://sme-tx-studio.cuhk.edu.cn/f/010/oauth2

# 可选：IdP 端点与声明名调整（不填则使用默认 CUHK ADFS 配置）
