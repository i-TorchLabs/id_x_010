# ====================================================================
# 环境变量加载优先级（高 → 低）：
#   1. 模块 .env  (x_models/id_x_010/.env)  — 本文件，覆盖根 .env 同名变量
#   2. 项目根 .env (i-Core/.env)
#
# 说明：高优先级的环境变量会覆盖低优先级的同名环境变量。
# ====================================================================

# --------------------------------------------------------------------
# 数据库配置（外部第三方 PostgreSQL，连接方式对齐 id_x_007）
# --------------------------------------------------------------------

# 本模块映射的数据库名（须在外部库上预先 CREATE DATABASE）
DB_NAME=id_x_010

# 外部第三方 PostgreSQL 连接参数（加密存储，用主程序 utils/encrypt_util.py
# 生成，运行时由引擎层 database_cli_util 自动解密；容器部署时也可由
# up.sh 注入明文环境变量覆盖）
DB_HOST=encrypted_db_host
DB_PORT=encrypted_db_port
DB_USERNAME=encrypted_db_username
DB_PASSWORD=encrypted_db_password

# --------------------------------------------------------------------
# 初始管理员账号（应用启动播种，幂等，取代原 ops/init/09_admin.sql）
# 目标邮箱不存在时由 build_tables 后播种（bcrypt 哈希落库）；
# 已存在则跳过，不覆盖已修改的密码/角色。留空则默认
# sme@cuhk.edu.cn / P@sssme!（与原 09_admin.sql 预置一致）。
# --------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --------------------------------------------------------------------
# 模型配置
# --------------------------------------------------------------------

# LLM 模型提供商（可选值: external | local）
# 决定运行时从 external_provider 表还是 local_provider 表读取
# 提供商配置（api_key 与各类 base_url），本项保留在配置文件中
LLM_PROVIDER=external
