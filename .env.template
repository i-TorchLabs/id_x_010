# ====================================================================
# 环境变量加载优先级（高 → 低）：
#   1. 模块 .env  (x_models/id_x_010/.env)  — 本文件，覆盖根 .env 同名变量
#   2. 项目根 .env (i-Core/.env)
#   3. config/base_config.toml              — 兜底默认值
#
# 说明：高优先级的环境变量会覆盖低优先级的同名环境变量。
# ====================================================================

# --------------------------------------------------------------------
# 数据库配置
# --------------------------------------------------------------------

# 本模块映射的数据库名（明文），其余连接参数（DB_HOST/DB_PORT/
# DB_USERNAME/DB_PASSWORD）由根 config/base_config.toml 的 [DATABASE] 段统一提供
DB_NAME=id_x_010

# --------------------------------------------------------------------
# 模型配置
# --------------------------------------------------------------------

# LLM 模型提供商（可选值: external | local）
LLM_PROVIDER=external

# 外部云端模型配置（LLM_PROVIDER=external 时生效）
EXTERNAL_API_KEY=your_EXTERNAL_API_Key_here
EXTERNAL_LLM_BASE_URL=https://api.siliconflow.cn/v1
EXTERNAL_EMBD_BASE_URL=https://api.siliconflow.cn/v1
EXTERNAL_VL_BASE_URL=https://api.siliconflow.cn/v1

# 本地 Ollama 模型配置（LLM_PROVIDER=local 时生效）
LOCAL_API_KEY=N/A
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_EMBD_BASE_URL=http://localhost:11434
LOCAL_VL_BASE_URL=http://localhost:11434

# --------------------------------------------------------------------
# SQL Agent 配置
# --------------------------------------------------------------------

# SQL Agent 映射数据库（加密环境变量）
# 这些变量需要加密后存储，使用项目提供的加密工具
AGENT_DB_NAME_ENC=encrypted_db_name
AGENT_DB_HOST_ENC=encrypted_db_host
AGENT_DB_PORT_ENC=encrypted_db_port
AGENT_DB_USERNAME_ENC=encrypted_db_username
AGENT_DB_PASSWORD_ENC=encrypted_db_password
AGENT_DB_LIST=xxx,yyy,zzz
